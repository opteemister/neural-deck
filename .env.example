# Runtime configuration for the native Linux service and a populated runtime
# `.env` copied by deploy.sh. Required values intentionally have no defaults:
# choose the service-visible paths and network binding for the target machine.
LLM_STUDIO_DATA_ROOT=
HOST=
PORT=
OPENAI_PORT=8080

# Optional paths. Leave them empty to derive MODELS_ROOT and LOG_ROOT from
# LLM_STUDIO_DATA_ROOT at application startup.
MODELS_ROOT=
LOG_ROOT=
EXTRA_VENV_ROOTS=

# Compose-only bind sources. They are host paths and are ignored by the native
# installer. The tracked `.env.local` supplies local defaults; set these in a
# populated root `.env` when the checkout's data, models, or logs live elsewhere.
LLM_STUDIO_COMPOSE_DATA_SOURCE=./data
LLM_STUDIO_COMPOSE_MODELS_SOURCE=./models
LLM_STUDIO_COMPOSE_LOG_SOURCE=./logs
