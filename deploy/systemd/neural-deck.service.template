[Unit]
Description=Neural Deck local model management service
After=network-online.target user@__SERVICE_UID__.service
Wants=network-online.target user@__SERVICE_UID__.service

[Service]
Type=simple
KillMode=control-group
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_PATH__
EnvironmentFile=/etc/neural-deck/neural-deck.env
Environment=NEURAL_DECK_PROJECT_PATH=__PROJECT_PATH__
Environment=NEURAL_DECK_BACKEND_DIR=__PROJECT_PATH__/backend
Environment=NEURAL_DECK_APP_MODULE=app.main:app
Environment=NEURAL_DECK_UV_BIN=__UV_BIN__
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NEURAL_DECK_MODEL_LAUNCHER=systemd
Environment="PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="CUDA_HOME=/usr/local/cuda"
ExecStart=/bin/bash __PROJECT_PATH__/deploy/run-service.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# The service can access model/GPU devices exposed by the target LXC. Build
# products and the project virtualenv are prepared before startup; at runtime
# only the configured persistent roots are writable.
ReadWritePaths=__DATA_ROOT__ __LOG_ROOT__
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
