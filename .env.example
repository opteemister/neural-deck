# Runtime configuration for the native Linux service and a populated runtime
# `.env` copied by deploy.sh. Required values intentionally have no defaults:
# choose the service-visible paths and network binding for the target machine.
NEURAL_DECK_DATA_ROOT=
HOST=
PORT=
OPENAI_PORT=8080

# Optional paths. Leave them empty to derive MODELS_ROOT and LOG_ROOT from
# NEURAL_DECK_DATA_ROOT at application startup.
MODELS_ROOT=
LOG_ROOT=
EXTRA_VENV_ROOTS=

# Optional Prometheus query API URL; empty uses local metrics.
PROMETHEUS_URL=

PROMETHEUS_TOKEN=

# MCP is enabled on the management origin at /mcp. These values only affect
# response sizing and export links; authentication is intentionally not used
# in the trusted local contour.
MCP_DEFAULT_PAGE_SIZE=20
MCP_MAX_PAGE_SIZE=
MCP_CURSOR_TTL_SECONDS=900
MCP_DEFAULT_TEXT_CHARS=4000
MCP_MAX_TEXT_CHARS=
MCP_DEFAULT_LOG_LINES=200
MCP_EXPORT_TTL_SECONDS=3600
MCP_PUBLIC_BASE_URL=
