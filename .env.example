# Runtime configuration for the native Linux service and a populated runtime
# `.env` copied by deploy.sh. Required values intentionally have no defaults:
# choose the service-visible paths and network binding for the target machine.
LLM_STUDIO_DATA_ROOT=
HOST=
PORT=
OPENAI_PORT=8080

# Optional paths. Leave them empty to derive MODELS_ROOT and LOG_ROOT from
# LLM_STUDIO_DATA_ROOT at application startup.
MODELS_ROOT=
LOG_ROOT=
EXTRA_VENV_ROOTS=

# Optional Prometheus query API URL; empty uses local metrics.
PROMETHEUS_URL=

PROMETHEUS_TOKEN=
