# Tracked, non-secret defaults used by local Docker Compose.
# Native installation uses the separately populated root `.env` instead.
LLM_STUDIO_DATA_ROOT=/var/lib/llm-studio
HOST=0.0.0.0
PORT=8000

# Keep the local mounts explicit. The application still accepts empty values
# in the native `.env` contract and derives these paths from the data root.
MODELS_ROOT=/var/lib/llm-studio/models
LOG_ROOT=/var/log/llm-studio
EXTRA_VENV_ROOTS=

# Compose-only host bind sources. Native installation ignores these values.
LLM_STUDIO_COMPOSE_DATA_SOURCE=./data
LLM_STUDIO_COMPOSE_MODELS_SOURCE=./models
LLM_STUDIO_COMPOSE_LOG_SOURCE=./logs
